.footer-brand h3 span {
    color: white;
}

.footer-brand p {
    color: #9ca3af;
}

.footer-links {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
}

.footer-links a:hover {
    color: var(--blue);
}

footer hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 25px 0;
}

.copyright {
    text-align: center;
    color: #9ca3af;
