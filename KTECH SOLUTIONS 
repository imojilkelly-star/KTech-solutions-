    list-style:none;
}

.nav-links a{
    color:white;
    font-weight:600;
    transition:.3s;
}

.nav-links a:hover{
    color:var(--blue);
}

.menu-btn{
    display:none;
    font-size:28px;
    cursor:pointer;
    color:white;
}

/* ================= HERO ================= */

.hero{
    min-height:650px;
    display:flex;
    align-items:center;
    text-align:center;
    background:
    linear-gradient(135deg,rgba(17,24,39,.95),rgba(30,58,138,.85)),
