}

.section-description {
    color: #b7c0ce;
    max-width: 800px;
    margin-bottom: 35px;
}

/* SERVICE CARDS */

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 22px;
}

.card {
    background: #111827;
    border: 1px solid #263348;
    border-radius: 16px;
    padding: 25px;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-7px);
    border-color: #00c3ff;
    box-shadow: 0 15px 35px rgba(0,0,0,0.3);
}

.card h3 {
    color: white;
    margin-bottom: 10px;
}

.card p {
    color: #b7c0ce;
}

/* PORTFOLIO */

.portfolio-card {
    min-height: 280px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    cursor: pointer;
}

.portfolio-card h3 {
    font-size: 20px;
}

.view-button {
    display: inline-block;
    margin-top: 20px;
    padding: 10px 14px;
    background: #00c3ff;
    color: #06111d;
    border-radius: 7px;
    font-weight: bold;
    text-align: center;
