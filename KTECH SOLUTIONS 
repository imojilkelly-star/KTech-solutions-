    margin-top: 25px;
    padding: 12px 20px;
    background: #00c3ff;
    color: #06111d;
    border-radius: 8px;
    font-weight: bold;
    transition: 0.3s;
}

.btn:hover {
    background: white;
    transform: translateY(-2px);
}

/* SECTIONS */

section {
