        grid-template-columns: repeat(2, 1fr);
    }

    .about-grid {
        grid-template-columns: 1fr;
    }

    .contact-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 700px) {

    .navbar {
        min-height: 65px;
    }

    .menu-button {
        display: block;
    }

    .nav-links {
        display: none;

        position: absolute;

        top: 65px;
        left: 0;

        width: 100%;

        background: var(--dark);

        flex-direction: column;

        padding: 20px;

        text-align: center;

        border-bottom: 1px solid var(--border);
    }

    .nav-links.show {
        display: flex;
    }

    .hero h1 {
        font-size: 38px;
    }

    .hero p {
        font-size: 17px;
    }

    .section-heading h2 {
        font-size: 30px;
    }

    .services-grid,
    .project-grid,
    .why-grid {
        grid-template-columns: 1fr;
    }

    .portfolio-section {
        padding: 25px;
    }

    .portfolio-section h3 {
        font-size: 26px;
    }

    .footer-content {
        flex-direction: column;
        text-align: center;
    }

    .footer-links {
        justify-content: center;
    }
}

</style>
</head>


