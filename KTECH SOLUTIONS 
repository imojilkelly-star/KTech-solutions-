<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#0b1120;
    color:#fff;
    line-height:1.6;
}

/* =========================
   HEADER
========================= */

header{
    background:#111827;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px 10%;
    position:sticky;
    top:0;
    z-index:1000;
    box-shadow:0 2px 15px rgba(0,0,0,.25);
}

.logo{
    font-size:28px;
    font-weight:bold;
    color:#00c3ff;
}

nav{
    display:flex;
    align-items:center;
    flex-wrap:wrap;
}

nav a{
    color:#fff;
    text-decoration:none;
    margin-left:20px;
    transition:.3s;
}

nav a:hover{
    color:#00c3ff;
}

/* =========================
   HERO
========================= */

.hero{
    text-align:center;
    padding:110px 20px;
    background:linear-gradient(135deg,#111827,#1e3a8a);
}

.hero h1{
    font-size:48px;
    margin-bottom:20px;
}

.hero p{
    font-size:20px;
    max-width:900px;
    margin:0 auto 30px;
    color:#e5e7eb;
}

.btn{
    display:inline-block;
    background:#00c3ff;
    color:#06111f;
    padding:13px 25px;
    text-decoration:none;
    border-radius:6px;
    font-weight:bold;
    transition:.3s;
}

.btn:hover{
    background:#fff;
    transform:translateY(-2px);
}

/* =========================
   GENERAL SECTIONS
========================= */

section{
    padding:75px 10%;
}

h2{
    text-align:center;
    color:#00c3ff;
    margin-bottom:40px;
    font-size:36px;
}

/* =========================
   SERVICES
========================= */

.services-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
}

.card{
    background:#1e293b;
    padding:25px;
    border-radius:10px;
    text-align:center;
    transition:.3s;
    border:1px solid transparent;
}

.card:hover{
    transform:translateY(-8px);
    border-color:#00c3ff;
}

.card h3{
    color:#00c3ff;
    margin-bottom:10px;
}

.card p{
    color:#d1d5db;
}

/* =========================
   ABOUT
========================= */

.about p{
    max-width:800px;
    margin:auto;
    text-align:center;
    color:#ddd;
}

/* =========================
   PORTFOLIO
========================= */

.portfolio-intro{
    max-width:800px;
    margin:-10px auto 40px;
    text-align:center;
    color:#ddd;
}

.portfolio-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:25px;
}

.portfolio-card{
    background:#111827;
    border:1px solid rgba(0,195,255,.15);
    border-radius:12px;
    overflow:hidden;
    transition:.3s ease;
}

.portfolio-card:hover{
    transform:translateY(-8px);
    border-color:#00c3ff;
    box-shadow:0 10px 30px rgba(0,195,255,.12);
}

.portfolio-icon{
    height:150px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:65px;
    background:linear-gradient(135deg,#111827,#1e3a8a);
}

.portfolio-content{
    padding:25px;
}

.portfolio-category{
    color:#00c3ff;
    font-size:12px;
    font-weight:bold;
    letter-spacing:1px;
}

.portfolio-content h3{
    margin:10px 0;
    color:#fff;
    font-size:22px;
}

.portfolio-content p{
    color:#ccc;
    font-size:15px;
    margin-bottom:18px;
}

.portfolio-tags{
    display:flex;
    flex-wrap:wrap;
    gap:7px;
    margin-bottom:20px;
}

.portfolio-tags span{
    background:#1e293b;
    color:#00c3ff;
    padding:5px 9px;
    border-radius:5px;
    font-size:12px;
}

.portfolio-btn{
    display:inline-block;
    background:#00c3ff;
    color:#06111f;
    padding:10px 17px;
    border-radius:6px;
    text-decoration:none;
    font-weight:bold;
    font-size:14px;
    transition:.3s;
}

.portfolio-btn:hover{
    background:#fff;
}

.portfolio-cta{
    text-align:center;
    margin-top:50px;
    padding:35px 20px;
    background:#111827;
    border-radius:12px;
    border:1px solid rgba(0,195,255,.15);
}

.portfolio-cta h3{
    color:#fff;
    margin-bottom:10px;
    font-size:24px;
}

.portfolio-cta p{
    color:#ccc;
    margin-bottom:20px;
}

/* =========================
   CONTACT
========================= */

.contact p{
    max-width:800px;
    margin:auto;
    text-align:center;
    color:#ddd;
    margin-bottom:15px;
}

/* =========================
   FOOTER
========================= */

footer{
    background:#111827;
    text-align:center;
    padding:20px;
    color:#cbd5e1;
