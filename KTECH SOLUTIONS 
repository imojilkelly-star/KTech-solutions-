/* =========================
   GENERAL
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #0b1120;
    color: #e5e7eb;
    line-height: 1.7;
}

a {
    text-decoration: none;
    color: inherit;
}

img {
    max-width: 100%;
}

.container {
    width: 100%;
    max-width: 1150px;
    margin: auto;
    padding: 70px 20px;
}


/* =========================
   HEADER
========================= */

header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #111827;
    border-bottom: 1px solid #263348;
}

.navbar {
    max-width: 1150px;
    margin: auto;
    padding: 16px 20px;

    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    color: #00c3ff;
    font-size: 25px;
    font-weight: bold;
}

nav {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
}

nav a {
    color: #e5e7eb;
    font-size: 15px;
}

nav a:hover {
    color: #00c3ff;
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 650px;

    display: flex;
    align-items: center;

    background:
    linear-gradient(
        135deg,
        #111827,
        #1e3a8a
    );
}

.badge {
    display: inline-block;

    padding: 7px 14px;

    border: 1px solid #00c3ff;
    border-radius: 30px;

    color: #7dd3fc;

    font-size: 13px;
    font-weight: bold;

    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);

    line-height: 1.1;

    color: white;

    max-width: 900px;

    margin-bottom: 20px;
}

.hero p {
    max-width: 800px;

    color: #dbeafe;

    font-size: 19px;
}

.btn {
    display: inline-block;

    margin-top: 25px;

    padding: 12px 20px;

    background: #00c3ff;

    color: #06111d;

    border-radius: 8px;

    font-weight: bold;

    transition: 0.3s;
}

.btn:hover {
    background: white;
    transform: translateY(-2px);
}


/* =========================
   SECTIONS
========================= */

section {
    scroll-margin-top: 80px;
}

.section-title {
    color: #00c3ff;

    font-size: 34px;

    margin-bottom: 12px;
}

.section-description {
    color: #b7c0ce;

    max-width: 800px;

    margin-bottom: 35px;
}


/* =========================
   GRID
========================= */

.grid {
    display: grid;

    grid-template-columns:
    repeat(
        auto-fit,
        minmax(260px, 1fr)
    );

    gap: 22px;
}


/* =========================
   CARDS
========================= */

.card {
    background: #111827;

    border: 1px solid #263348;

    border-radius: 16px;

    padding: 25px;

    transition: 0.3s;
}

.card:hover {
    transform: translateY(-7px);

    border-color: #00c3ff;

    box-shadow:
    0 15px 35px
    rgba(0,0,0,0.3);
}

.card h3 {
    color: white;

    margin-bottom: 10px;
}

.card p {
    color: #b7c0ce;
}


/* =========================
   CLICKABLE SERVICE CARDS
========================= */

.service-link {
    display: block;
}

.service-card {
    min-height: 230px;

    display: flex;

    flex-direction: column;

    justify-content: space-between;

    cursor: pointer;
}

.service-card:hover {
    border-color: #00c3ff;
}


/* =========================
   PORTFOLIO
========================= */

.portfolio-card {

    min-height: 300px;

    display: flex;

    flex-direction: column;

    justify-content: space-between;

    cursor: pointer;
}

.portfolio-card h3 {
    font-size: 20px;
}

.portfolio-card:hover {
    border-color: #00c3ff;
}

.view-button {

    display: inline-block;

    margin-top: 20px;

    padding: 10px 14px;

    background: #00c3ff;

    color: #06111d;

    border-radius: 7px;

    font-weight: bold;

    text-align: center;
}

.tags {

    display: flex;

    flex-wrap: wrap;

    gap: 7px;

    margin-top: 18px;
}

.tag {

    background: #172033;

    border: 1px solid #2b3a50;

    color: #93c5fd;

    padding: 5px 9px;

    border-radius: 20px;

    font-size: 12px;
}


/* =========================
   ABOUT
========================= */

