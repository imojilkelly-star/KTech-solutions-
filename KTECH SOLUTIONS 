/* =========================
   WHATSAPP
========================= */

.whatsapp-btn{
    position:fixed;
    bottom:20px;
    right:20px;
    background:#25D366;
    color:#fff;
    text-decoration:none;
    padding:15px 20px;
    border-radius:50px;
    font-weight:bold;
    z-index:1001;
    box-shadow:0 5px 20px rgba(0,0,0,.3);
}

/* =========================
   MOBILE
========================= */

@media(max-width:700px){

    header{
        padding:15px 5%;
        flex-direction:column;
        gap:12px;
    }

    nav{
        justify-content:center;
    }

    nav a{
        margin:4px 8px;
        font-size:14px;
    }

    .hero{
        padding:80px 20px;
    }

    .hero h1{
        font-size:36px;
    }

    .hero p{
        font-size:17px;
    }

    section{
        padding:60px 5%;
    }

    h2{
        font-size:30px;
    }

    .portfolio-grid{
        grid-template-columns:1fr;
    }

}

</style>

</head>

