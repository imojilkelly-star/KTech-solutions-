}

.hero-content{
    max-width:850px;
    margin:auto;
}

.hero h1{
    font-size:52px;
    line-height:1.15;
    margin-bottom:20px;
}

.hero h1 span{
    color:var(--blue);
}

.hero p{
    font-size:19px;
    color:var(--text);
    margin-bottom:30px;
}

.btn{
    display:inline-block;
    padding:13px 25px;
    border-radius:8px;
    font-weight:bold;
    margin:6px;
    transition:.3s;
}

.btn-primary{
    background:var(--blue);
    color:#001018;
}

.btn-primary:hover{
    transform:translateY(-3px);
}

.btn-outline{
    border:1px solid var(--blue);
    color:var(--blue);
}

.btn-outline:hover{
    background:var(--blue);
    color:#001018;
}

