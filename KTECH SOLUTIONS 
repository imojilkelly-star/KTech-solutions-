/* =====================================================
   KTECH SOLUTIONS - COMPLETE ONE FILE WEBSITE
===================================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

:root {
    --blue: #00c3ff;
    --dark: #0b1120;
    --dark2: #111827;
    --dark3: #050914;
    --white: #ffffff;
    --text: #d1d5db;
    --border: #263247;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--dark);
    color: var(--white);
    line-height: 1.7;
}

a {
    text-decoration: none;
    color: inherit;
}

.container {
    width: 90%;
    max-width: 1150px;
    margin: auto;
}

/* =====================================================
   HEADER
===================================================== */

header {
    position: sticky;
    top: 0;
    z-index: 9999;
    background: rgba(11,17,32,0.97);
    border-bottom: 1px solid var(--border);
}

.navbar {
    min-height: 70px;
    width: 90%;
    max-width: 1150px;
    margin: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 25px;
    font-weight: bold;
    color: var(--blue);
}

.logo span {
    color: white;
}

.nav-links {
    display: flex;
    gap: 24px;
    list-style: none;
}

.nav-links a {
    font-weight: bold;
    transition: 0.3s;
}

.nav-links a:hover {
    color: var(--blue);
}

.menu-button {
    display: none;
    background: none;
    border: none;
    color: white;
    font-size: 28px;
    cursor: pointer;
}

/* =====================================================
   GENERAL BUTTONS
===================================================== */

.btn {
    display: inline-block;
    padding: 13px 25px;
    border-radius: 8px;
    font-weight: bold;
    margin: 5px;
    transition: 0.3s;
}

.btn-primary {
    background: var(--blue);
    color: #06111c;
}

.btn-outline {
    border: 1px solid var(--blue);
    color: var(--blue);
}

.btn:hover {
    transform: translateY(-3px);
    background: white;
    color: #06111c;
}

/* =====================================================
   HERO
===================================================== */

.hero {
    min-height: 88vh;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;

    padding: 80px 20px;

    background:
        linear-gradient(
            135deg,
            #111827,
            #1e3a8a
        );
}

.hero-content {
    max-width: 900px;
}

.hero-label {
    color: var(--blue);
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: 55px;
    line-height: 1.15;
    margin-bottom: 25px;
}

.hero h1 span {
    display: block;
    color: var(--blue);
}

.hero p {
    color: var(--text);
    font-size: 19px;
    max-width: 800px;
    margin: 0 auto 30px;
}

.hero-buttons {
    margin-top: 20px;
}

/* =====================================================
   SECTIONS
===================================================== */

.section {
    padding: 90px 0;
}

.section-heading {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 50px;
}

.section-heading span {
    color: var(--blue);
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 2px;
}

.section-heading h2 {
    font-size: 38px;
    margin: 10px 0;
}

.section-heading p {
    color: var(--text);
}

/* =====================================================
   ABOUT
===================================================== */

.about {
    background: var(--dark2);
}

.about-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 40px;
    align-items: center;
}

.about-text p {
    color: var(--text);
    margin-bottom: 18px;
}

.about-card {
    background: var(--dark);
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 40px;
    text-align: center;
}

.about-icon {
    font-size: 55px;
    margin-bottom: 15px;
}

.about-card h3 {
    color: var(--blue);
    margin-bottom: 10px;
}

.about-card p {
    color: var(--text);
}

/* =====================================================
   SERVICES
===================================================== */

.services {
    background: var(--dark);
}

.services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.service-card {
    display: block;
    background: var(--dark2);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 30px;
    transition: 0.3s;
    cursor: pointer;
}

.service-card:hover {
    transform: translateY(-8px);
    border-color: var(--blue);
    box-shadow: 0 10px 30px rgba(0,195,255,0.12);
}

.service-icon {
    font-size: 42px;
    margin-bottom: 15px;
}

.service-card h3 {
    color: var(--blue);
    margin-bottom: 12px;
}

.service-card p {
    color: var(--text);
    margin-bottom: 20px;
}

.service-card .view {
    color: var(--blue);
    font-weight: bold;
}

/* =====================================================
   PORTFOLIO
===================================================== */

.portfolio {
    background: var(--dark2);
}

.portfolio-intro {
    max-width: 800px;
    margin: auto;
    text-align: center;
    color: var(--text);
    margin-bottom: 45px;
}

.portfolio-section {
    scroll-margin-top: 90px;
    background: var(--dark);
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 40px;
    margin-bottom: 30px;
}

.portfolio-section:nth-child(even) {
    background: #0f172a;
}

.portfolio-label {
    color: var(--blue);
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 1.5px;
}

.portfolio-section h3 {
    font-size: 30px;
    margin: 10px 0 15px;
}

.portfolio-section > p {
    color: var(--text);
    max-width: 850px;
}

.project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 30px;
}

.project-card {
    background: var(--dark2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 25px;
}

.project-card:hover {
    border-color: var(--blue);
}

.project-card h4 {
    color: var(--blue);
    font-size: 20px;
    margin-bottom: 10px;
}

.project-card p {
    color: var(--text);
}

.project-card ul {
